// Feature Spec: SkSL Transitions Expansion
//
// Status: Implemented

FeatureSpec(
    title: "SkSL Transitions Expansion",

    user_story: "As a video creator, I want to use more transition types (wave, glitch, iris, spiral, zoom_in, radial_wipe, pixelate) so that I can create varied visual content without writing custom shaders.",

    priority: 2,

    scripting_requirements: [
        ScriptingRequirement(
            function_name: "add_transition",
            signature: "add_transition(from: SceneHandle, to: SceneHandle, type: &str, duration: f64, easing: &str, params: Map?)",
            doc_comment: Some("Adds a transition between two scenes. Type strings: fade, slide_left, slide_right, wipe_left, wipe_right, circle_open, wave, glitch, iris, spiral, zoom_in, radial_wipe, pixelate."),
        ),
    ],

    pipeline_requirements: [
        PipelineRequirement(
            description: "Implement 7 SkSL transition shaders in director-core/src/systems/transitions.rs",
            affected_area: Some("director-core/src/systems/transitions.rs"),
        ),
        PipelineRequirement(
            description: "Register new transition type strings in lifecycle.rs add_transition_internal",
            affected_area: Some("director-core/src/scripting/api/lifecycle.rs"),
        ),
    ],

    verification: VerificationSpec(
        script_compiles: true,
        schema_validates: true,
        custom_scripts: [],
        test_cases: [
            "add_transition with type 'wave' creates Wave transition with default params",
            "add_transition with type 'iris' and params { start_radius: 10.0 } creates Iris with overridden start_radius",
            "add_transition with type 'zoom_in' creates ZoomIn transition",
            "All 7 shaders compile and render without SkSL errors",
        ],
    ),
)
