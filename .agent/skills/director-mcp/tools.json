{
  "tools": [
    {
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Open an input as a session at revision 0. Returns the session id, source kind, missing fonts, compositions and outline.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "composition": {
            "description": "Script composition to open",
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "description": "Seconds for inputs that do not set a duration (default 5)",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "fps": {
            "description": "Frame rate for inputs that do not set one (default 30)",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "height": {
            "description": "Canvas height for inputs that do not set one (default 1080)",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "input": {
            "description": "Rhai, HTML, capture JSON, native .dirproj or core project JSON path, relative to the server directory",
            "type": "string"
          },
          "props": {
            "description": "Script composition props as JSON or a JSON file path"
          },
          "width": {
            "description": "Canvas width for inputs that do not set one (default 1920)",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "name": "open"
    },
    {
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Close a session and free its renderers.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "session": {
            "description": "Session id from `open`",
            "type": "string"
          }
        },
        "required": [
          "session"
        ],
        "type": "object"
      },
      "name": "close"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "The node tree with authored names, the clips and the current revision.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "session": {
            "description": "Session id from `open`",
            "type": "string"
          }
        },
        "required": [
          "session"
        ],
        "type": "object"
      },
      "name": "outline"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Document, added, removed, moved and changed nodes between two sessions as JSON pointers, with `patch`: the ops that turn `before` into `after` when `patchable`.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "Session id to diff to",
            "type": "string"
          },
          "before": {
            "description": "Session id to diff from",
            "type": "string"
          }
        },
        "required": [
          "after",
          "before"
        ],
        "type": "object"
      },
      "name": "diff"
    },
    {
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Apply patch ops atomically and return the new revision. `set` replaces the value at a JSON pointer in a node record (`{\"op\":\"set\",\"node\":\"box\",\"path\":\"/opacity\",\"value\":0.5}`), `set_document` one in the document, `remove` drops a subtree.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_revision": {
            "description": "Revision the ops were written against; a stale revision fails with `conflict`. Defaults to the current revision.",
            "format": "uint64",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "ops": {
            "description": "Ops applied in order; any failure rejects them all",
            "items": {
              "description": "One edit of the document.",
              "oneOf": [
                {
                  "description": "Replace the value at JSON pointer `path` inside the node record, such as `/opacity` or `/body/text`. Identity and tree fields (`/id`, `/parent`, `/children`) are fixed.",
                  "properties": {
                    "node": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "description": "Stable identity. Matches `director-core`'s generational `NodeId`.",
                          "properties": {
                            "generation": {
                              "description": "Slot generation. A recycled slot has a new generation.",
                              "format": "uint32",
                              "minimum": 0.0,
                              "type": "integer"
                            },
                            "index": {
                              "description": "Arena slot.",
                              "format": "uint32",
                              "minimum": 0.0,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "generation",
                            "index"
                          ],
                          "type": "object"
                        }
                      ],
                      "description": "A node by authored name (an HTML `id`) or by generational id."
                    },
                    "op": {
                      "enum": [
                        "set"
                      ],
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "value": true
                  },
                  "required": [
                    "node",
                    "op",
                    "path",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "description": "Replace the value at JSON pointer `path` of the document, such as `/fps` or `/timeline/tracks/0/clips/0/duration`. `/version` is fixed and `/nodes` changes through the node ops.",
                  "properties": {
                    "op": {
                      "enum": [
                        "set_document"
                      ],
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "value": true
                  },
                  "required": [
                    "op",
                    "path",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "description": "Remove the node and its subtree. A clip's scene root or a mask that a remaining node uses cannot be removed.",
                  "properties": {
                    "node": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "description": "Stable identity. Matches `director-core`'s generational `NodeId`.",
                          "properties": {
                            "generation": {
                              "description": "Slot generation. A recycled slot has a new generation.",
                              "format": "uint32",
                              "minimum": 0.0,
                              "type": "integer"
                            },
                            "index": {
                              "description": "Arena slot.",
                              "format": "uint32",
                              "minimum": 0.0,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "generation",
                            "index"
                          ],
                          "type": "object"
                        }
                      ],
                      "description": "A node by authored name (an HTML `id`) or by generational id."
                    },
                    "op": {
                      "enum": [
                        "remove"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "node",
                    "op"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "array"
          },
          "session": {
            "description": "Session id from `open`",
            "type": "string"
          }
        },
        "required": [
          "ops",
          "session"
        ],
        "type": "object"
      },
      "name": "patch"
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Source ids, layout bounds, timeline and audio of the current revision at a time.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "session": {
            "description": "Session id from `open`",
            "type": "string"
          },
          "time": {
            "default": 0.0,
            "description": "Seconds into the timeline",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "session"
        ],
        "type": "object"
      },
      "name": "inspect"
    },
    {
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Paint one frame of the current revision as PNG.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "output": {
            "description": "Write the PNG here and return its path; without it the PNG returns as image content",
            "type": [
              "string",
              "null"
            ]
          },
          "session": {
            "description": "Session id from `open`",
            "type": "string"
          },
          "time": {
            "default": 0.0,
            "description": "Seconds into the timeline",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "session"
        ],
        "type": "object"
      },
      "name": "render_frame"
    },
    {
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Export the current revision as a video file. Fails with `missing_font` when required fonts are absent.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "alpha": {
            "description": "Leave uncovered pixels clear and write VP9 with alpha",
            "type": [
              "boolean",
              "null"
            ]
          },
          "draft": {
            "default": false,
            "description": "Software x264 ultrafast at CRF 30",
            "type": "boolean"
          },
          "encoder": {
            "default": "software",
            "description": "Video encoder",
            "enum": [
              "software",
              "nvenc"
            ],
            "type": "string"
          },
          "output": {
            "description": "Video path",
            "type": "string"
          },
          "scale": {
            "description": "Raster scale in (0, 1]",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "session": {
            "description": "Session id from `open`",
            "type": "string"
          }
        },
        "required": [
          "output",
          "session"
        ],
        "type": "object"
      },
      "name": "export"
    }
  ]
}
